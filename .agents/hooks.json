{
  "beginner-guard": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./guard.js",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./guard.js",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./guard.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
